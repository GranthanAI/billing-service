# billing-service local environment. Copy to .env (or export) before `make run-api` / the worker.
ENVIRONMENT=development
BILLING_DATABASE_URL=postgresql+asyncpg://billing_app:billing_app@localhost:5433/billing_db
BILLING_MIGRATION_DATABASE_URL=postgresql+asyncpg://billing_migrator:billing_migrator@localhost:5433/billing_db
BILLING_VALKEY_URL=redis://localhost:6380/0
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
GATEWAY_SHARED_SECRET=dev-gateway-secret
SERVICE_TOKEN_KEYS=dev-service-token
SUPPLIER_STATE_CODE=10
PLANS_FILE=config/plans.yaml

# --- payments: real Razorpay, or the simulator (never in production) ---
PAYMENT_SIMULATION=true
# With PAYMENT_SIMULATION=true these may be any non-empty strings; the simulator signs with them.
RAZORPAY_KEY_ID=rzp_sim_key
RAZORPAY_KEY_SECRET=sim_key_secret
RAZORPAY_WEBHOOK_SECRET=sim_webhook_secret

# --- simulator knobs (only read when PAYMENT_SIMULATION=true) ---
ALLOW_GATEWAY_MODE_SWITCH=false
SIM_MONTH_SECONDS=0
SIM_RETRY_INTERVAL=86400
SIM_FAST_JOBS=false
SIM_REFUND_DELAY_SECONDS=10
SIM_WEBHOOK_URL=http://localhost:8080/billing/v1/webhooks/razorpay
SIM_WEBHOOK_DELAY_SECONDS=1
SIM_WEBHOOK_DUPLICATE_PCT=0
SIM_WEBHOOK_DROP_PCT=0
SIM_WEBHOOK_REORDER=false
# GRACE_PERIOD_SECONDS=300   # overrides GRACE_DAYS when set
FRONTEND_ORIGIN=http://localhost:5173

# --- transactional email (the worker sends; the API never does) ---
EMAIL_MODE=file          # console | file | smtp (console and file are refused in production)
EMAIL_ENABLED=true
EMAIL_OUTBOX_DIR=./.email-outbox
EMAIL_FROM=GranthanAI <billing@granthan.ai>
# EMAIL_REPLY_TO=
SUPPORT_EMAIL=support@granthan.ai
# SMTP_HOST=
# SMTP_PORT=587          # 587 STARTTLS, 465 SSL
# SMTP_USERNAME=
# SMTP_PASSWORD=

# Messages one user may send per minute, every plan (the plan sheet safety limit). Unset = the catalog value
# (payg.max_messages_per_minute: 30). -1 switches it off. A refused message gets 429 limit.per_minute.
# MAX_MESSAGES_PER_MINUTE=30

# Pay as you Go (wallet, top-ups, credits, Ultra by credits). Off by default: the wallet routes answer 404 and /plans omits payg.
# PAYG_ENABLED=true

# llm-service availability (M2)
LLM_SERVICE_URL=http://llm-service:8000
LLM_SERVICE_TOKEN=

# --- organisation-service (organisations, memberships, seats) ---
# Without ORG_SERVICE_URL nobody is a member of any organisation and the org plan is never granted (fine in development, refused in
# production). ONE token goes both ways: billing sends it to organisation-service (it must equal the "billing:" entry of
# organisation-service's INTERNAL_SERVICE_TOKENS) and organisation-service sends it back on /internal/orgs/{id}/usage and
# /subscription (it must be organisation-service's BILLING_SERVICE_TOKEN). Dev value: dev-billing-token in all three places.
ORG_SERVICE_URL=http://127.0.0.1:8010
ORG_SERVICE_TOKEN=dev-billing-token
