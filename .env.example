# billing-service local environment. Copy to .env (or export) before `make run-api` / the worker.
ENVIRONMENT=development
BILLING_DATABASE_URL=postgresql+asyncpg://billing_app:billing_app@localhost:5433/billing_db
BILLING_MIGRATION_DATABASE_URL=postgresql+asyncpg://billing_migrator:billing_migrator@localhost:5433/billing_db
BILLING_VALKEY_URL=redis://localhost:6380/0
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
GATEWAY_SHARED_SECRET=dev-gateway-secret
SERVICE_TOKEN_KEYS=dev-service-token
SUPPLIER_STATE_CODE=10
PLANS_FILE=config/plans.yaml

# --- payments: real Razorpay, or the simulator (never in production) ---
PAYMENT_SIMULATION=true
# With PAYMENT_SIMULATION=true these may be any non-empty strings; the simulator signs with them.
RAZORPAY_KEY_ID=rzp_sim_key
RAZORPAY_KEY_SECRET=sim_key_secret
RAZORPAY_WEBHOOK_SECRET=sim_webhook_secret

# --- simulator knobs (only read when PAYMENT_SIMULATION=true) ---
ALLOW_GATEWAY_MODE_SWITCH=false
SIM_MONTH_SECONDS=0
SIM_RETRY_INTERVAL=86400
SIM_FAST_JOBS=false
SIM_REFUND_DELAY_SECONDS=10
SIM_WEBHOOK_URL=http://localhost:8080/billing/v1/webhooks/razorpay
SIM_WEBHOOK_DELAY_SECONDS=1
SIM_WEBHOOK_DUPLICATE_PCT=0
SIM_WEBHOOK_DROP_PCT=0
SIM_WEBHOOK_REORDER=false
# GRACE_PERIOD_SECONDS=300   # overrides GRACE_DAYS when set
FRONTEND_ORIGIN=http://localhost:5173
